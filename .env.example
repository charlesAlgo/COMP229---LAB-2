# Copy this file to ".env" and fill in your own values.
NODE_ENV=development
PORT=3000

# Local MongoDB (MongoDB Compass / mongod running on your machine)
MONGODB_URI=mongodb://127.0.0.1:27017/Portfolio

# MongoDB Atlas - use this form instead if you are on Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Portfolio?retryWrites=true&w=majority

JWT_SECRET=change_me_to_a_long_random_string
CLIENT_ORIGIN=http://localhost:5173
