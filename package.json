{
  "name": "myportfolio",
  "version": "1.0.0",
  "description": "Portfolio application - Node.js, Express REST APIs and MongoDB (COMP 229 Assignment 2)",
  "author": "Charles Shalua",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
